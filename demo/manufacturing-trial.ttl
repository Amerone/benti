@prefix : <http://www.semanticweb.org/hifar/ontologies/2026/3/untitled-ontology-12/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/hifar/ontologies/2026/3/untitled-ontology-12/> .

<https://hifar.top/manufacturing-trial/ontology> rdf:type owl:Ontology .

#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/hifar/ontologies/2026/3/untitled-ontology-12/appliesToTrial
:appliesToTrial rdf:type owl:ObjectProperty ;
                rdfs:domain :Parameter ;
                rdfs:range :Trial ;
                rdfs:comment "参数适用于哪个试验"@zh-cn .


###  http://www.semanticweb.org/hifar/ontologies/2026/3/untitled-ontology-12/evaluatedAgainst
:evaluatedAgainst rdf:type owl:ObjectProperty ;
                  rdfs:domain :Result ;
                  rdfs:range :Specification ;
                  rdfs:comment "判定结果按哪个规格版本得出"@zh-cn .


###  http://www.semanticweb.org/hifar/ontologies/2026/3/untitled-ontology-12/hasBatch
:hasBatch rdf:type owl:ObjectProperty ;
          rdfs:domain :Trial ;
          rdfs:range :Batch ;
          rdfs:comment "试验包含批次"@zh-cn .


###  http://www.semanticweb.org/hifar/ontologies/2026/3/untitled-ontology-12/hasMeasurement
:hasMeasurement rdf:type owl:ObjectProperty ;
                rdfs:domain :Batch ;
                rdfs:range :Measurement ;
                rdfs:comment "批次包含测量记录"@zh-cn .


###  http://www.semanticweb.org/hifar/ontologies/2026/3/untitled-ontology-12/hasParameter
:hasParameter rdf:type owl:ObjectProperty ;
              rdfs:domain :Measurement ;
              rdfs:range :Parameter ;
              rdfs:comment "测量记录使用哪个参数"@zh-cn .


###  http://www.semanticweb.org/hifar/ontologies/2026/3/untitled-ontology-12/hasResult
:hasResult rdf:type owl:ObjectProperty ;
           rdfs:domain :Measurement ;
           rdfs:range :Result ;
           rdfs:comment "测量记录有哪些判定结果"@zh-cn .


###  http://www.semanticweb.org/hifar/ontologies/2026/3/untitled-ontology-12/hasSpecification
:hasSpecification rdf:type owl:ObjectProperty ;
                  rdfs:domain :Measurement ;
                  rdfs:range :Specification ;
                  rdfs:comment "测量记录原始采用的规格"@zh-cn .


###  http://www.semanticweb.org/hifar/ontologies/2026/3/untitled-ontology-12/impactedMeasurement
:impactedMeasurement rdf:type owl:ObjectProperty ;
                     rdfs:domain :SpecChangeImpact ;
                     rdfs:range :Measurement ;
                     rdfs:comment "规格变更影响哪条测量"@zh-cn .


###  http://www.semanticweb.org/hifar/ontologies/2026/3/untitled-ontology-12/newResult
:newResult rdf:type owl:ObjectProperty ;
           rdfs:domain :SpecChangeImpact ;
           rdfs:range :Result ;
           rdfs:comment "变更后结果"@zh-cn .


###  http://www.semanticweb.org/hifar/ontologies/2026/3/untitled-ontology-12/previousResult
:previousResult rdf:type owl:ObjectProperty ;
                rdfs:domain :SpecChangeImpact ;
                rdfs:range :Result ;
                rdfs:comment "变更前结果"@zh-cn .


###  http://www.semanticweb.org/hifar/ontologies/2026/3/untitled-ontology-12/supersedes
:supersedes rdf:type owl:ObjectProperty ;
            rdfs:domain :Specification ;
            rdfs:range :Specification ;
            rdfs:comment "新规格替代旧规格"@zh-cn .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/hifar/ontologies/2026/3/untitled-ontology-12/batchCode
:batchCode rdf:type owl:DatatypeProperty ;
           rdfs:domain :Batch ;
           rdfs:range xsd:string ;
           rdfs:comment "B03"@zh-cn .


###  http://www.semanticweb.org/hifar/ontologies/2026/3/untitled-ontology-12/batchGradient
:batchGradient rdf:type owl:DatatypeProperty ;
               rdfs:domain :Batch ;
               rdfs:range xsd:string ;
               rdfs:comment "高温梯度 193°C"@zh-cn .


###  http://www.semanticweb.org/hifar/ontologies/2026/3/untitled-ontology-12/changeReason
:changeReason rdf:type owl:DatatypeProperty ;
              rdfs:domain :Specification ;
              rdfs:range xsd:string ;
              rdfs:comment "初始试制规格"@zh-cn .


###  http://www.semanticweb.org/hifar/ontologies/2026/3/untitled-ontology-12/deviation
:deviation rdf:type owl:DatatypeProperty ;
           rdfs:domain :Result ;
           rdfs:range xsd:decimal .


###  http://www.semanticweb.org/hifar/ontologies/2026/3/untitled-ontology-12/effectiveFrom
:effectiveFrom rdf:type owl:DatatypeProperty ;
               rdfs:domain :Specification ;
               rdfs:range xsd:dateTime .


###  http://www.semanticweb.org/hifar/ontologies/2026/3/untitled-ontology-12/evidenceLowerLimit
:evidenceLowerLimit rdf:type owl:DatatypeProperty ;
                    rdfs:domain :Result ;
                    rdfs:range xsd:decimal .


###  http://www.semanticweb.org/hifar/ontologies/2026/3/untitled-ontology-12/evidenceUpperLimit
:evidenceUpperLimit rdf:type owl:DatatypeProperty ;
                    rdfs:domain :Result ;
                    rdfs:range xsd:decimal .


###  http://www.semanticweb.org/hifar/ontologies/2026/3/untitled-ontology-12/evidenceValue
:evidenceValue rdf:type owl:DatatypeProperty ;
               rdfs:domain :Result ;
               rdfs:range xsd:decimal .


###  http://www.semanticweb.org/hifar/ontologies/2026/3/untitled-ontology-12/impactReason
:impactReason rdf:type owl:DatatypeProperty ;
              rdfs:domain :SpecChangeImpact ;
              rdfs:range xsd:string ;
              rdfs:comment "规格上限从 195°C 收紧到 190°C，M007 超上限 3.5°C"@zh-cn .


###  http://www.semanticweb.org/hifar/ontologies/2026/3/untitled-ontology-12/inferenceRule
:inferenceRule rdf:type owl:DatatypeProperty ;
               rdfs:domain :Result ;
               rdfs:range xsd:string .


###  http://www.semanticweb.org/hifar/ontologies/2026/3/untitled-ontology-12/judgedAt
:judgedAt rdf:type owl:DatatypeProperty ;
          rdfs:domain :Result ;
          rdfs:range xsd:dateTime .


###  http://www.semanticweb.org/hifar/ontologies/2026/3/untitled-ontology-12/limitSource
:limitSource rdf:type owl:DatatypeProperty ;
             rdfs:domain :Parameter ;
             rdfs:range xsd:string ;
             rdfs:comment "Specification"@zh-cn .


###  http://www.semanticweb.org/hifar/ontologies/2026/3/untitled-ontology-12/lowerLimit
:lowerLimit rdf:type owl:DatatypeProperty ;
            rdfs:domain :Specification ;
            rdfs:range xsd:decimal .


###  http://www.semanticweb.org/hifar/ontologies/2026/3/untitled-ontology-12/measurementId
:measurementId rdf:type owl:DatatypeProperty ;
               rdfs:domain :Measurement ;
               rdfs:range xsd:string ;
               rdfs:comment "M007"@zh-cn .


###  http://www.semanticweb.org/hifar/ontologies/2026/3/untitled-ontology-12/measurementTime
:measurementTime rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Measurement ;
                 rdfs:range xsd:dateTime ;
                 rdfs:comment "2026-04-20T09:30:00+08:00"@zh-cn .


###  http://www.semanticweb.org/hifar/ontologies/2026/3/untitled-ontology-12/measurementValue
:measurementValue rdf:type owl:DatatypeProperty ;
                  rdfs:domain :Measurement ;
                  rdfs:range xsd:decimal ;
                  rdfs:comment 193.5 .


###  http://www.semanticweb.org/hifar/ontologies/2026/3/untitled-ontology-12/parameterCode
:parameterCode rdf:type owl:DatatypeProperty ;
               rdfs:domain :Parameter ;
               rdfs:range xsd:string ;
               rdfs:comment "INJECTION_TEMPERATURE"@zh-cn .


###  http://www.semanticweb.org/hifar/ontologies/2026/3/untitled-ontology-12/parameterName
:parameterName rdf:type owl:DatatypeProperty ;
               rdfs:domain :Parameter ;
               rdfs:range xsd:string ;
               rdfs:comment "注塑温度"@zh-cn .


###  http://www.semanticweb.org/hifar/ontologies/2026/3/untitled-ontology-12/participatesInInference
:participatesInInference rdf:type owl:DatatypeProperty ;
                         rdfs:domain :Parameter ;
                         rdfs:range xsd:boolean ;
                         rdfs:comment "true"@zh-cn .


###  http://www.semanticweb.org/hifar/ontologies/2026/3/untitled-ontology-12/resultStatus
:resultStatus rdf:type owl:DatatypeProperty ;
              rdfs:domain :Result ;
              rdfs:range xsd:string .


###  http://www.semanticweb.org/hifar/ontologies/2026/3/untitled-ontology-12/specVersion
:specVersion rdf:type owl:DatatypeProperty ;
             rdfs:domain :Specification ;
             rdfs:range xsd:string ;
             rdfs:comment "Spec_v1"@zh-cn .


###  http://www.semanticweb.org/hifar/ontologies/2026/3/untitled-ontology-12/trialCode
:trialCode rdf:type owl:DatatypeProperty ;
           rdfs:domain :Trial ;
           rdfs:range xsd:string ;
           rdfs:comment "T001"@zh-cn .


###  http://www.semanticweb.org/hifar/ontologies/2026/3/untitled-ontology-12/unit
:unit rdf:type owl:DatatypeProperty ;
      rdfs:domain :Parameter ;
      rdfs:range xsd:string ;
      rdfs:comment "°C"@zh-cn .


###  http://www.semanticweb.org/hifar/ontologies/2026/3/untitled-ontology-12/upperLimit
:upperLimit rdf:type owl:DatatypeProperty ;
            rdfs:domain :Specification ;
            rdfs:range xsd:decimal .


###  http://www.semanticweb.org/hifar/ontologies/2026/3/untitled-ontology-12/valueType
:valueType rdf:type owl:DatatypeProperty ;
           rdfs:domain :Parameter ;
           rdfs:range xsd:string ;
           rdfs:comment "number"@zh-cn .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/hifar/ontologies/2026/3/untitled-ontology-12/Batch
:Batch rdf:type owl:Class ;
       rdfs:subClassOf [ rdf:type owl:Restriction ;
                         owl:onProperty :hasMeasurement ;
                         owl:allValuesFrom :Measurement
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :batchCode ;
                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onDataRange xsd:string
                       ] ;
       rdfs:comment """试制批次
表示温度梯度批次，如 B01、B02、B03"""@zh-cn ;
       rdfs:label "试制批次"@zh-cn .


###  http://www.semanticweb.org/hifar/ontologies/2026/3/untitled-ontology-12/FailHighResult
:FailHighResult rdf:type owl:Class ;
                rdfs:subClassOf :Result .


###  http://www.semanticweb.org/hifar/ontologies/2026/3/untitled-ontology-12/FailLowResult
:FailLowResult rdf:type owl:Class ;
               rdfs:subClassOf :Result .


###  http://www.semanticweb.org/hifar/ontologies/2026/3/untitled-ontology-12/Measurement
:Measurement rdf:type owl:Class ;
             rdfs:subClassOf [ rdf:type owl:Restriction ;
                               owl:onProperty :hasResult ;
                               owl:someValuesFrom :Result
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :hasParameter ;
                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onClass :Parameter
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :measurementValue ;
                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onDataRange xsd:decimal
                             ] ;
             rdfs:comment """测量记录
表示一条真实测量事实，如 M007 = 193.5 °C"""@zh-cn ;
             rdfs:label "测量记录"@zh-cn .


###  http://www.semanticweb.org/hifar/ontologies/2026/3/untitled-ontology-12/Parameter
:Parameter rdf:type owl:Class ;
           rdfs:comment """测量参数
表示注塑温度、振动频率等可扩展参数"""@zh-cn ;
           rdfs:label "测量参数"@zh-cn .


###  http://www.semanticweb.org/hifar/ontologies/2026/3/untitled-ontology-12/PassResult
:PassResult rdf:type owl:Class ;
            rdfs:subClassOf :Result .


###  http://www.semanticweb.org/hifar/ontologies/2026/3/untitled-ontology-12/Result
:Result rdf:type owl:Class ;
        rdfs:subClassOf [ rdf:type owl:Restriction ;
                          owl:onProperty :evaluatedAgainst ;
                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onClass :Specification
                        ] ;
        rdfs:comment """判定结果
表示一次判定事实，保存规则名、偏差、证据"""@zh-cn ;
        rdfs:label "判定结果"@zh-cn .


###  http://www.semanticweb.org/hifar/ontologies/2026/3/untitled-ontology-12/SpecChangeImpact
:SpecChangeImpact rdf:type owl:Class ;
                  rdfs:comment """规格变更影响
表示规格变化导致哪些测量结论发生变化"""@zh-cn ;
                  rdfs:label "规格变更影响"@zh-cn .


###  http://www.semanticweb.org/hifar/ontologies/2026/3/untitled-ontology-12/Specification
:Specification rdf:type owl:Class ;
               rdfs:subClassOf [ rdf:type owl:Restriction ;
                                 owl:onProperty :lowerLimit ;
                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:decimal
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :specVersion ;
                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:string
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :upperLimit ;
                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:decimal
                               ] ;
               rdfs:comment """规格版本
表示 Spec_v1、Spec_v2，不覆盖旧版本"""@zh-cn ;
               rdfs:label "规格版本"@zh-cn .


###  http://www.semanticweb.org/hifar/ontologies/2026/3/untitled-ontology-12/Trial
:Trial rdf:type owl:Class ;
       rdfs:subClassOf [ rdf:type owl:Restriction ;
                         owl:onProperty :hasBatch ;
                         owl:someValuesFrom :Batch
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :trialCode ;
                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onDataRange xsd:string
                       ] ;
       rdfs:comment """试验
表示一次完整试验，如 T001 注塑工艺验证"""@zh-cn ;
       rdfs:label "试验"@zh-cn .


#################################################################
#    Individuals
#################################################################

###  http://www.semanticweb.org/hifar/ontologies/2026/3/untitled-ontology-12/test-1
:test-1 rdf:type owl:NamedIndividual ,
                 [ rdf:type owl:Restriction ;
                   owl:onProperty :trialCode ;
                   owl:someValuesFrom xsd:string
                 ] .


