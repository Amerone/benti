# ontology-id: manufacturing-trial
# ontology-label: 制造业试验数据管理本体
# ontology-version: 1.0.0
# ontology-swrl: manufacturing-trial.swrl

@prefix mto: <https://hifar.top/mto#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://hifar.top/mto/ontology/manufacturing-trial> rdf:type owl:Ontology .

#################################################################
#    Object Properties
#################################################################

###  https://hifar.top/mto#appliesToTrial
mto:appliesToTrial rdf:type owl:ObjectProperty ;
                rdfs:domain mto:Parameter ;
                rdfs:range mto:Trial ;
                rdfs:comment "参数适用于哪个试验"@zh-cn .


###  https://hifar.top/mto#evaluatedAgainst
mto:evaluatedAgainst rdf:type owl:ObjectProperty ;
                  rdfs:domain mto:Result ;
                  rdfs:range mto:Specification ;
                  rdfs:comment "判定结果按哪个规格版本得出"@zh-cn .


###  https://hifar.top/mto#hasBatch
mto:hasBatch rdf:type owl:ObjectProperty ;
          rdfs:domain mto:Trial ;
          rdfs:range mto:Batch ;
          rdfs:comment "试验包含批次"@zh-cn .


###  https://hifar.top/mto#belongsToTrial
mto:belongsToTrial rdf:type owl:ObjectProperty ;
                owl:inverseOf mto:hasBatch ;
                rdfs:domain mto:Batch ;
                rdfs:range mto:Trial ;
                rdfs:comment "批次归属于哪个试验"@zh-cn .


###  https://hifar.top/mto#hasMeasurement
mto:hasMeasurement rdf:type owl:ObjectProperty ;
                rdfs:domain mto:Batch ;
                rdfs:range mto:Measurement ;
                rdfs:comment "批次包含测量记录"@zh-cn .


###  https://hifar.top/mto#forBatch
mto:forBatch rdf:type owl:ObjectProperty ;
             owl:inverseOf mto:hasMeasurement ;
             rdfs:domain mto:Measurement ;
             rdfs:range mto:Batch ;
             rdfs:comment "测量记录所属批次"@zh-cn .


###  https://hifar.top/mto#hasParameter
mto:hasParameter rdf:type owl:ObjectProperty ;
              rdfs:domain mto:Measurement ;
              rdfs:range mto:Parameter ;
              rdfs:comment "测量记录使用哪个参数"@zh-cn .


###  https://hifar.top/mto#forParameter
mto:forParameter rdf:type owl:ObjectProperty ;
              owl:equivalentProperty mto:hasParameter ;
              rdfs:domain mto:Measurement ;
              rdfs:range mto:Parameter ;
              rdfs:comment "测量记录对应的参数"@zh-cn .


###  https://hifar.top/mto#hasResult
mto:hasResult rdf:type owl:ObjectProperty ;
           rdfs:domain mto:Measurement ;
           rdfs:range mto:Result ;
           rdfs:comment "测量记录有哪些判定结果"@zh-cn .


###  https://hifar.top/mto#forMeasurement
mto:forMeasurement rdf:type owl:ObjectProperty ;
                owl:inverseOf mto:hasResult ;
                rdfs:domain mto:Result ;
                rdfs:range mto:Measurement ;
                rdfs:comment "判定结果对应的测量记录"@zh-cn .


###  https://hifar.top/mto#hasLatestResult
mto:hasLatestResult rdf:type owl:ObjectProperty ;
                 rdfs:domain mto:Measurement ;
                 rdfs:range mto:Result ;
                 rdfs:comment "测量记录当前最新判定结果"@zh-cn .


###  https://hifar.top/mto#hasSpecification
mto:hasSpecification rdf:type owl:ObjectProperty ;
                  rdfs:domain mto:Measurement ;
                  rdfs:range mto:Specification ;
                  rdfs:comment "测量记录原始采用的规格"@zh-cn .


###  https://hifar.top/mto#impactedMeasurement
mto:impactedMeasurement rdf:type owl:ObjectProperty ;
                     rdfs:domain mto:SpecChangeImpact ;
                     rdfs:range mto:Measurement ;
                     rdfs:comment "规格变更影响哪条测量"@zh-cn .


###  https://hifar.top/mto#newResult
mto:newResult rdf:type owl:ObjectProperty ;
           rdfs:domain mto:SpecChangeImpact ;
           rdfs:range mto:Result ;
           rdfs:comment "变更后结果"@zh-cn .


###  https://hifar.top/mto#previousResult
mto:previousResult rdf:type owl:ObjectProperty ;
                rdfs:domain mto:SpecChangeImpact ;
                rdfs:range mto:Result ;
                rdfs:comment "变更前结果"@zh-cn .


###  https://hifar.top/mto#supersedes
mto:supersedes rdf:type owl:ObjectProperty ;
            rdfs:domain mto:Specification ;
            rdfs:range mto:Specification ;
            rdfs:comment "新规格替代旧规格"@zh-cn .


###  https://hifar.top/mto#supersedesSpec
mto:supersedesSpec rdf:type owl:ObjectProperty ;
                owl:equivalentProperty mto:supersedes ;
                rdfs:domain mto:Specification ;
                rdfs:range mto:Specification ;
                rdfs:comment "规格版本替代链"@zh-cn .


###  https://hifar.top/mto#supersededBy
mto:supersededBy rdf:type owl:ObjectProperty ;
              rdfs:domain mto:Result ;
              rdfs:range mto:Result ;
              rdfs:comment "旧判定结果被新结果替代"@zh-cn .


